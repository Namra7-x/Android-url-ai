: 0.02em;\r\n    padding: 0 22px;\r\n    white-space: nowrap;\r\n}\r\n.achievement-sep {\r\n    color: #ffd700;\r\n    font-size: 16px;\r\n    line-height: 1;\r\n    flex-shrink: 0;\r\n}\r\n@keyframes achievementScroll {\r\n    0%   { transform: translateX(0); }\r\n    100% { transform: translateX(-50%); }\r\n}\r\n@media (max-width: 767px) {\r\n    .achievement-ticker-wrap {\r\n        position: fixed;\r\n        top: 0;\r\n        left: 50%;\r\n        margin-left: -50vw;\r\n        width: 100vw;\r\n        z-index: 9999;\r\n        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);\r\n    }\r\n    .achievement-ticker-inner {\r\n        animation-duration: 60s;\r\n    }\r\n    .achievement-item {\r\n        font-size: 12px;\r\n        padding: 0 16px;\r\n    }\r\n    .heading {\r\n        margin-top: 46px;\r\n    }\r\n}\r\n\u003c/style\u003e\r\n\r\n\u003cdiv class=\"achievement-ticker-wrap\"\u003e\r\n    \u003cdiv class=\"achievement-ticker-inner\"\u003e\r\n        \r\n        \u003cdiv class=\"achievement-ticker-set\"\u003e\r\n            \u003cspan class=\"achievement-item\"\u003eExcellence in Academic Achievement \u0026mdash; Education World 2026 \u0026nbsp;\u0026bull;\u0026nbsp; #1 in Gujarat\u003c/span\u003e\r\n            \u003cspan class=\"achievement-sep\"\u003e\u0026bull;\u003c/span\u003e\r\n            \u003cspan class=\"achievement-item\"\u003eThe Times Education Icons Award 2025 \u0026mdash; Excellence in Multidisciplinary and Innovative Education\u003c/span\u003e\r\n            \u003cspan class=\"achievement-sep\"\u003e\u0026bull;\u003c/span\u003e\r\n            \u003cspan class=\"achievement-item\"\u003eExcellence in Industry Embedded Curriculum \u0026amp; Delivery at Times Education Awards 2024\u003c/span\u003e\r\n            \u003cspan class=\"achievement-sep\"\u003e\u0026bull;\u003c/span\u003e\r\n            \u003cspan class=\"achievement-item\"\u003eEmerging University of Gujarat at Times Education Awards 2023\u003c/span\u003e\r\n            \u003cspan c