lor: #000; font-size: 18px; font-weight: 600; margin-bottom: 20px;\"\u003eSchool of Aviation \u0026 Hospitality\u003c/h5\u003e\r\n            \u003cul class=\"footer-item-links\" style=\"list-style: none; padding: 0; margin: 0;\"\u003e\r\n                \u003cli style=\"margin-bottom: 8px;\"\u003e\r\n                    \u003ca href=\"https://jguni.edu.in/view-page/bba-mba---aviation-hospitality--travel-management\" style=\"color: #000; font-size: 15px; text-decoration: none; display: block; padding: 6px 0;\"\u003e\r\n                        Integrated BBA + MBA - 5 years, 10 semesters\u003cspan style=\"font-size: 13px; color: #444; display: block; margin-top: 3px;\"\u003eiMBA - Aviation, Hospitality \u0026 Travel Management\u003c/span\u003e\r\n                    \u003c/a\u003e\r\n                \u003c/li\u003e\r\n                \u003cli style=\"margin-bottom: 8px;\"\u003e\r\n                    \u003ca href=\"https://jguni.edu.in/view-page/master-in-aviation-hospitality--travel-management\" style=\"color: #000; font-size: 15px; text-decoration: none; display: block; padding: 6px 0;\"\u003e\r\n                        Masters in Aviation, Hospitality \u0026 Travel Management - 2 years, 4 semesters\u003cspan style=\"font-size: 13px; color: #444; display: block; margin-top: 3px;\"\u003eMasters in Aviation, Hospitality \u0026 Travel Management\u003c/span\u003e\r\n                    \u003c/a\u003e\r\n                \u003c/li\u003e\r\n            \u003c/ul\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n\r\n    \u003c!-- Contact Information --\u003e\r\n    \u003cdiv class=\"col-lg-12 col-md-12 col-sm-12\" style=\"margin-bottom: 20px;\"\u003e\r\n        \u003cdiv class=\"footer-item\" style=\"text-align: center;\"\u003e\r\n            \u003ch5 style=\"color: #000; font-size: 18px; font-weight: 600; margin-bottom: 20px;\"\u003eContact Information\u003c/h5\u003e\r\n            \u003cdiv class=\"row\"\u003e\r\n                \u003cdiv class=\"col-lg-4 col-