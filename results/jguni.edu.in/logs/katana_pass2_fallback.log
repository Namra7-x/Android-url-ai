nWorld Awards 2023\u003c/span\u003e\r\n            \u003cspan class=\"achievement-sep\"\u003e\u0026bull;\u003c/span\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n\u003c/div\u003e\r\n\r\n\r\n                                                                                                \u003c/div\u003e\r\n                                            \u003c/div\u003e\r\n                \u003c/div\u003e\r\n                                \u003c/section\u003e\r\n    \r\n\u003csection class=\"pb-themesection \"  \u003e\r\n            \r\n            \r\n            \r\n            \u003cdiv class=\"container-fluid\"\u003e\r\n                \u003cdiv class=\"row droppable-container\" data-id=\"399cjg6b25\"\u003e\r\n                                            \u003cdiv class=\"col-12 p-0\"\u003e\r\n                                                            \r\n                                \u003cdiv class=\"full-width\" \u003e\r\n                                                                            \u003cstyle\u003e\r\n    \r\n    .hero_area_container_slide_item {\r\n        padding-left: 12px!important;\r\n        padding-right: 12px!important;\r\n    }\r\n\u003c/style\u003e\r\n\u003csection class=\"hero_area_slider  owl-carousel\"\u003e\r\n                        \u003cdiv class=\"hero_area\" id=\"slider-1\"\u003e\r\n                \u003cdiv class=\"container-fluid hero_area_container_slide_item\"\u003e\r\n                    \u003cdiv class=\"row\"\u003e\r\n                        \u003cdiv class=\"col-md-12 p-0\"\u003e\r\n                            \u003cdiv class=\"hero_area_inner\"\u003e\r\n                                \u003ca href=\"home\" target=\"__blank\"\u003e\r\n                                    \u003cimg src=\"https://jguni.edu.in/public/uploads/theme/edulia/home_slider/5a9b447021d2e0053f962458e1c5f926.jpg\" alt=\"hero slider\"\u003e\r\n                                \u003c/a\u003e\r\n                            \u003c/div\u003e