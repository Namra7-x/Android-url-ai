ters\u003c/a\u003e\u003c/li\u003e\r\n                            \u003cli\u003e\u003ca href=\"https://jguni.edu.in/view-page/msc-cyber-security--digital-forensics\"\u003eM.Sc. - Cyber Security \u0026amp; Digital Forensics - 2 years, 4 semesters\u003c/a\u003e\u003c/li\u003e\r\n                            \u003cli\u003e\u003ca href=\"https://jguni.edu.in/view-page/msc-forensic-science--technology\"\u003eM.Sc. - Forensic Science \u0026amp; Technology - 2 years, 4 semesters\u003c/a\u003e\u003c/li\u003e\r\n                            \u003cli\u003e\u003ca href=\"https://jguni.edu.in/view-page/msc-clinical-embryology--assisted-reproductive-technologies\"\u003eM.Sc. - Clinical Embryology \u0026amp; ART - 2 years, 4 semesters\u003c/a\u003e\u003c/li\u003e\r\n                            \u003cli\u003e\u003ca href=\"https://jguni.edu.in/view-page/llm\"\u003eLL.M. - 2 years, 4 semesters\u003c/a\u003e\u003c/li\u003e\r\n                        \u003c/ul\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n            \u003c/div\u003e\r\n            \u003c!-- Doctoral --\u003e\r\n            \u003cdiv class=\"col-md-6 col-lg-4\"\u003e\r\n                \u003cdiv class=\"pro-box\"\u003e\r\n                    \u003cimg class=\"img-fluid\" src=\"https://jguni.edu.in/public/images/images/phd-programmes.jpg\" loading=\"lazy\" width=\"450\" height=\"450\" style=\"max-width: 100%; height: auto;\" alt=\"Doctoral Programmes (Ph.D)\"\u003e\r\n                    \u003cdiv class=\"hover-box red-bg\"\u003e\r\n                        \u003ch3\u003eDoctoral\u003c/h3\u003e\r\n                        \u003cul\u003e\r\n                            \u003cli\u003e\u003ca href=\"https://jguni.edu.in/view-page/doctoral-programmes\"\u003eCommerce\u003c/a\u003e\u003c/li\u003e\r\n                            \u003cli\u003e\u003ca href=\"https://jguni.edu.in/view-page/doctoral-programmes\"\u003eManagement\u003c/a\u003e\u003c/li\u003e\r\n                            \u003cli\u003e\u003ca href=\"https://jguni.edu.in/view-page/doctoral-programmes\"\u003eComputing\u003c/a\u003e\u003c/li\u003e\r\n                            \u003cli\u003e\u003ca href=\"https://jguni.edu.in/view-page/doctoral-programmes\"\u003eInterdisciplinary\u003c/a\u003e\u003c/li\u003e\r\n                            \u003cli\u003e\u003ca href=\"https://jguni.edu.in/view-page/doctoral-programmes\"\u003eLaw\u003c/a\u003e\u003c/li\u003e\r\n                            \u003cli\u003e\u003ca href=\"https://jguni.edu.in/view-page/doctoral-programmes\"\u003eForensic Science\u003c/a\u003e\u003c/li\u003e\r\n                        \u003c/ul\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n            \u003c/div\u003e\r\n            \u003c!-- Certificate Courses --\u003e\r\n            \u003c!--\u003cdiv class=\"col-md-6 col-lg-3\"\u003e--\u003e\r\n            \u003c!--    \u003cdiv class=\"pro-box\"\u003e--\u003e\r\n            \u003c!--        \u003cimg class=\"img-fluid\" src=\"https://jguni.edu.in/public/images/images/certificate-courses.jpg\" loading=\"lazy\" width=\"450\" height=\"450\" style=\"max-width: 100%; height: auto;\" alt=\"Certificate Courses\"\u003e--\u003e\r\n            \u003c!--        \u003cdiv class=\"hover-box blue-bg\"\u003e--\u003e\r\n            \u003c!--            \u003ch3\u003eCertificate Courses\u003c/h3\u003e--\u003e\r\n            \u003c!--            \u003cul\u003e--\u003e\r\n            \u003c!--                \u003cli\u003e\u003ca href=\"https://jguni.edu.in/view-page/certificate-course-in-metaverse\"\u003eMetaverse\u003c/a\u003e\u003c/li\u003e--\u003e\r\n            \u003c!--                \u003cli\u003e\u003ca href=\"https://jguni.edu.in/view-page/certificate-course-in-data-science-ai-ml\"\u003eData Science, AI-ML\u003c/a\u003e\u003c/li\u003e--\u003e\r\n            \u003c!--                \u003cli\u003e\u003ca href=\"https://jguni.edu.in/view-page/mobile-applications\"\u003eMobile Applications\u003c/a\u003e\u003c/li\u003e--\u003e\r\n            \u003c!--                \u003cli\u003e\u003ca href=\"https://jguni.edu.in/view-page/blockchain\"\u003eBlockchain\u003c/a\u003e\u003c/li\u003e--\u003e\r\n            \u003c!--                \u003cli\u003e\u003ca href=\"https://jguni.edu.in/view-page/digital-marketing\"\u003eDigital Marketing\u003c/a\u003e\u003c/li\u003e--\u003e\r\n            \u003c!--                \u003cli\u003e\u003ca href=\"https://jguni.edu.in/view-page/cyber-security-programme\"\u003eCyber Security\u003c/a\u003e\u003c/li\u003e--\u003e\r\n            \u003c!--                \u003cli\u003e\u003ca href=\"https://jguni.edu.in/view-page/robotic-process-automation\"\u003eRobotic Process Automation\u003c/a\u003e\u003c/li\u003e--\u003e\r\n            \u003c!--                \u003cli\u003e\u003ca href=\"https://jguni.edu.in/view-page/industrial-iot\"\u003eIndustrial IoT\u003c/a\u003e\u003c/li\u003e--\u003e\r\n            \u003c!--                \u003cli\u003e\u003ca href=\"https://jguni.edu.in/view-page/full-stack-architect\"\u003eFull Stack Architect\u003c/a\u003e\u003c/li\u003e--\u003e\r\n            \u003c!--                \u003cli\u003e\u003ca href=\"https://jguni.edu.in/view-page/azure-devops\"\u003eAzure DevOps\u003c/a\u003e\u003c/li\u003e--\u003e\r\n            \u003c!--            \u003c/ul\u003e--\u003e\r\n            \u003c!--        \u003c/div\u003e--\u003e\r\n            \u003c!--    \u003c/div\u003e--\u003e\r\n            \u003c!--\u003c/div\u003e--\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n\u003c/section\u003e\r\n\r\n\u003cscript\u003e\r\n(function() {\r\n    function isMobile() {\r\n        return window.innerWidth \u003c= 767;\r\n    }\r\n\r\n    function initProBoxHover() {\r\n        var boxes = document.querySelectorAll('.programmes-section .pro-box');\r\n        boxes.forEach(function(box) {\r\n            var hoverBox = box.querySelector('.hover-box');\r\n            if (!hoverBox) return;\r\n\r\n            box.addEventListener('mouseenter', function() {\r\n                if (!isMobile()) {\r\n                    hoverBox.style.height = box.offsetHeight + 'px';\r\n                    hoverBox.classList.add('expanded');\r\n                }\r\n            });\r\n            box.addEventListener('mouseleave', function() {\r\n                if (!isMobile()) {\r\n                    hoverBox.style.height = '50px';\r\n                    hoverBox.classList.remove('expanded');\r\n                }\r\n            });\r\n        });\r\n    }\r\n\r\n    function initMobileToggle() {\r\n        var headings = document.querySelectorAll('.programmes-section .hover-box h3');\r\n        headings.forEach(function(h3) {\r\n            h3.addEventListener('click', function(e) {\r\n                if (isMobile()) {\r\n                    e.stopPropagation();\r\n                    var hoverBox = h3.closest('.hover-box');\r\n                    hoverBox.classList.toggle('mobile-expanded');\r\n                }\r\n            });\r\n        });\r\n    }\r\n\r\n    if (document.readyState === 'loading') {\r\n        document.addEventListener('DOMContentLoaded', function() {\r\n            initProBoxHover();\r\n            initMobileToggle();\r\n        });\r\n    } else {\r\n        initProBoxHover();\r\n        initMobileToggle();\r\n    }\r\n})();\r\n\u003c/script\u003e\r\n\r\n                                                                    \u003c/div\u003e\r\n                                                    \u003c/div\u003e\r\n                                    \u003c/div\u003e\r\n            \u003c/div\u003e\r\n\r\n                    \u003c/section\u003e\r\n            \r\n        \u003csection class=\"pb-themesection \"  \u003e\r\n            \r\n            \r\n            \r\n            \u003cdiv class=\"container-fluid\"\u003e\r\n                \u003cdiv class=\"row droppable-container\" data-id=\"36b934ac8g\"\u003e\r\n                                            \u003cdiv class=\"col-12 p-0\"\u003e\r\n                                                            \r\n                                \u003cdiv class=\"\" \u003e\r\n                                                                            \u003csection class=\"section_padding home_speech_section\"\u003e\r\n    \u003cdiv class=\"container\"\u003e\r\n        \u003cdiv class=\"row\"\u003e\r\n            \u003cdiv class=\"col-md-12\"\u003e\r\n                \u003cdiv class=\"section_title\"\u003e\r\n                    \u003cspan class=\"section_title_meta\"\u003eJG University\u003c/span\u003e\r\n                    \u003ch2\u003eOur Leaders\u003c/h2\u003e\r\n                \u003c/div\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"owl-carousel\"\u003e\r\n                        \u003cdiv class=\"single_speech_item\"\u003e\r\n                \u003cdiv class=\"speaker_photo\"\u003e\r\n                    \u003cimg src=\"https://jguni.edu.in/public/uploads/theme/edulia/speech_slider/d0819a8d81f7e815f9685c0f8073d770.jpg\" alt=\"Dr. M.P Chandran\"\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"speaker_name\" style=\"font-weight: 700; font-size: 1.1rem; margin-bottom: 4px;\"\u003eDr. M.P Chandran\u003c/div\u003e\r\n                \u003cdiv class=\"speaker_info\"\u003ePresident,\u003cbr\u003eJG University\u003c/div\u003e\r\n                \u003chr style=\"border: none; border-top: 2px solid #ffffff; width: 60%; margin: 8px auto;\"\u003e\r\n                \u003cdiv class=\"speech\"\u003e\r\n                    Message From President\r\n                \u003c/div\u003e\r\n                \u003cbutton class=\"speech_details view-details-btn\" \r\n                        data-image=\"https://jguni.edu.in/public/uploads/theme/edulia/speech_slider/d0819a8d81f7e815f9685c0f8073d770.jpg\"\r\n                        data-name=\"Dr. M.P Chandran\"\r\n                        data-designation=\"President,\"\r\n                        data-title=\"Message From President\"\r\n                         data-content=\"\u0026lt;p style=\u0026quot;margin-bottom: 1rem; color: rgb(0, 0, 0); line-height: 30px; font-size: 15px; font-family: OpenSans-Regular;\u0026quot;\u0026gt;Knowledge is the power that no one can take away from you. The education system of today needs to be upgraded to impart knowledge that is not only cognitive but also experiential so as to help students shape their future, with their ability to match employment/self-employment requirements. Education must focus on nurturing the youth with the capabilities to acquire knowledge and skills that will help them learn and become eminent practitioners.\u0026lt;/p\u0026gt;\u0026lt;p style=\u0026quot;margin-bottom: 1rem; color: rgb(0, 0, 0); line-height: 30px; font-size: 15px; font-family: OpenSans-Regular;\u0026quot;\u0026gt;JG University empowers its students not to restrict themselves rather explore and gain wisdom beyond the pages of books. University’s pedagogy is designed to match the everyday challenges and at the same time bring out the academic brilliance of knowledge seekers.\u0026lt;/p\u0026gt;\u0026lt;p style=\u0026quot;margin-bottom: 1rem; color: rgb(0, 0, 0); line-height: 30px; font-size: 15px; font-family: OpenSans-Regular;\u0026quot;\u0026gt;All the best!\u0026lt;/p\u0026gt;\"\u003e\r\n                    Details                \u003c/button\u003e\r\n            \u003c/div\u003e\r\n                    \u003cdiv class=\"single_speech_item\"\u003e\r\n                \u003cdiv class=\"speaker_photo\"\u003e\r\n                    \u003cimg src=\"https://jguni.edu.in/public/uploads/theme/edulia/speech_slider/45faeb2bd766866bc3296978b85b4d2b.jpg\" alt=\"Dr. CA Achyut Dani\"\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"speaker_name\" style=\"font-weight: 700; font-size: 1.1rem; margin-bottom: 4px;\"\u003eDr. CA Achyut Dani\u003c/div\u003e\r\n                \u003cdiv class=\"speaker_info\"\u003eDirector-General and Provost,\u003cbr\u003eJG University\u003c/div\u003e\r\n                \u003chr style=\"border: none; border-top: 2px solid #ffffff; width: 60%; margin: 8px auto;\"\u003e\r\n                \u003cdiv class=\"speech\"\u003e\r\n                    Message From Director-General and Provost\r\n                \u003c/div\u003e\r\n                \u003cbutton class=\"speech_details view-details-btn\" \r\n                        data-image=\"https://jguni.edu.in/public/uploads/theme/edulia/speech_slider/45faeb2bd766866bc3296978b85b4d2b.jpg\"\r\n                        data-name=\"Dr. CA Achyut Dani\"\r\n                        data-designation=\"Director-General and Provost,\"\r\n                        data-title=\"Message From Director-General and Provost\"\r\n                         data-content=\"\u0026lt;span style=\u0026quot;color: rgb(0, 0, 0); font-family: OpenSans-Regular; font-size: 15px;\u0026quot;\u0026gt;Excellence is a matter of choice. If we choose to be excellent, we will be for sure. JG University aims to bring excellence in everything that it does, be it for students, faculty, staff, parents or any of its stakeholders. We stand by the idea of knowledge beyond books and provide students a real-life experience with an industry-relevant curriculum. The University desires to strike an equilibrium between state-of-the-art infrastructure and high-quality education that is recognised globally. We have a focused and dedicated environment that ensures a successful future for our students. Our commitment towards our students is reflected in the resources we bring to them and the mentorship we provide them at every stage to become global change leaders with appropriate skills and values\u0026lt;/span\u0026gt;\"\u003e\r\n                    Details                \u003c/button\u003e\r\n            \u003c/div\u003e\r\n            \u003c/div\u003e    \u003c/div\u003e\r\n\u003c/section\u003e\r\n\r\n\u003c!-- Speech Modal --\u003e\r\n\u003cdiv class=\"modal fade speech-modal\" id=\"speechModal\" tabindex=\"-1\" aria-hidden=\"true\"\u003e\r\n    \u003cdiv class=\"modal-dialog modal-dialog-centered\"\u003e\r\n        \u003cdiv class=\"modal-content\"\u003e\r\n            \u003cdiv class=\"modal-header\"\u003e\r\n                \u003ch5 class=\"modal-title\"\u003eOur Leaders\u003c/h5\u003e\r\n                \u003cbutton type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"\u003e\u003c/button\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class=\"modal-body\"\u003e\r\n                \u003cdiv class=\"single-speech\"\u003e\r\n                    \u003cdiv class=\"text-center\"\u003e\r\n                        \u003cdiv class=\"speaker-image-container\"\u003e\r\n                            \u003cimg id=\"modalSpeakerImage\" src=\"\" class=\"speaker-image\" alt=\"Speaker\"\u003e\r\n                        \u003c/div\u003e\r\n                        \u003cdiv class=\"speech_of mb-4\"\u003e\r\n                            \u003ch3 id=\"modalSpeakerName\"\u003e\u003c/h3\u003e\r\n                            \u003cp id=\"modalSpeakerDesignation\"\u003e\u003c/p\u003e\r\n                        \u003c/div\u003e\r\n                    \u003c/div\u003e\r\n                    \u003cdiv class=\"speech_inner\"\u003e\r\n                        \u003cdiv id=\"modalSpeechContent\" class=\"speech-content\"\u003e\r\n                            \u003c!-- Content will be dynamically populated --\u003e\r\n                        \u003c/div\u003e\r\n                    \u003c/div\u003e\r\n                \u003c/div\u003e\r\n            \u003c/div\u003e\r\n            \u003cdiv class=\"modal-footer\"\u003e\r\n                \u003cbutton type=\"button\" class=\"btn btn-secondary\" data-bs-dismiss=\"modal\"\u003eClose\u003c/button\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n\u003c/div\u003e\r\n\r\n\r\n                                                                    \u003c/div\u003e\r\n                                                    \u003c/div\u003e\r\n                                    \u003c/div\u003e\r\n            \u003c/div\u003e\r\n\r\n                    \u003c/section\u003e\r\n            \r\n        \u003csection class=\"pb-themesection \"  \u003e\r\n            \r\n            \r\n            \r\n            \u003cdiv class=\"container-fluid\"\u003e\r\n                \u003cdiv class=\"row droppable-container\" data-id=\"3671aiaj00\"\u003e\r\n                                            \u003cdiv class=\"col-12 p-0\"\u003e\r\n                                                    \u003c/div\u003e\r\n                                    \u003c/div\u003e\r\n            \u003c/div\u003e\r\n\r\n                    \u003c/section\u003e\r\n            \r\n        \u003csection class=\"pb-themesection \"  \u003e\r\n            \r\n            \r\n            \r\n            \u003cdiv class=\"container-fluid\"\u003e\r\n                \u003cdiv class=\"row droppable-container\" data-id=\"36b9734j6b\"\u003e\r\n                                            \u003cdiv class=\"col-12 p-0\"\u003e\r\n                                                    \u003c/div\u003e\r\n                                    \u003c/div\u003e\r\n            \u003c/div\u003e\r\n\r\n                    \u003c/section\u003e\r\n            \r\n        \u003csection class=\"pb-themesection \"  \u003e\r\n            \r\n            \r\n            \r\n            \u003cdiv class=\"container-fluid\"\u003e\r\n                \u003cdiv class=\"row droppable-container\" data-id=\"3671aii9c7\"\u003e\r\n                                            \u003cdiv class=\"col-12 p-0\"\u003e\r\n                                                            \r\n                                \u003cdiv class=\"full-width\" \u003e\r\n                                                                            \u003c!-- cta area start --\u003e\r\n\u003csection class=\"section_padding_off cta_area\"\r\n     style=\"background-image: url('http://v2.jguni.in/public/storage/optionbuilder/uploads/9011-21-2023_1127amcta-bg.png')\" \u003e\r\n    \u003cdiv class=\"container\"\u003e\r\n        \u003cdiv class=\"row\"\u003e\r\n            \u003cdiv class=\"col-md-12 text-center\"\u003e\r\n                \u003cdiv class=\"section_title\"\u003e\r\n                    \u003ch2\u003eEver wondered what JG University looks like? Take a virtual tour!\u003c/h2\u003e\r\n                    \u003cp\u003e\u003cbr\u003e\u003c/p\u003e\r\n                \u003c/div\u003e\r\n                \u003cdiv class=\"cta_area_inner\" style=\"margin-top: 20px;\"\u003e\r\n                    \u003ca href=\"https://jguni.edu.in/view-page/campus-jg-university\" class=\"boxed_btn\"\u003eClick here to start your tour!\u003c/a\u003e\r\n                \u003c/div\u003e\r\n                            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n\u003c/section\u003e\r\n\u003c!-- cta area end --\u003e\r\n\r\n\u003c!-- funfact area start --\u003e\r\n\u003csection class=\"section_padding_off funfact\"\u003e\r\n    \u003cdiv class=\"container\"\u003e\r\n        \u003cdiv class=\"row\"\u003e\r\n            \u003cdiv class=\"col-md-10 offset-md-1\"\u003e\r\n                \u003cdiv class=\"row text-center\" id='counters'\u003e\r\n                                                                        \u003cdiv class=\"col-md-4\"\u003e\r\n                                \u003cdiv class=\"funfact_item\"\u003e\r\n                                    \u003ch3\u003e\u003cspan class=\"counter\" data-TargetNum=\"265\"\r\n                                            data-Speed=\"2000\"\u003e265\u003c/span\u003e+\r\n                                    \u003c/h3\u003e\r\n                                    \u003cp\u003eExpert Faculties\u003c/p\u003e\r\n                                \u003c/div\u003e\r\n                            \u003c/div\u003e\r\n                                                    \u003cdiv class=\"col-md-4\"\u003e\r\n                                \u003cdiv class=\"funfact_item\"\u003e\r\n                                    \u003ch3\u003e\u003cspan class=\"counter\" data-TargetNum=\"7500\"\r\n                                            data-Speed=\"2000\"\u003e7500\u003c/span\u003e+\r\n                                    \u003c/h3\u003e\r\n                                    \u003cp\u003eTotal Students\u003c/p\u003e\r\n                                \u003c/div\u003e\r\n                            \u003c/div\u003e\r\n                                                    \u003cdiv class=\"col-md-4\"\u003e\r\n                                \u003cdiv class=\"funfact_item\"\u003e\r\n                                    \u003ch3\u003e\u003cspan class=\"counter\" data-TargetNum=\"200\"\r\n                                            data-Speed=\"2000\"\u003e200\u003c/span\u003e+\r\n                                    \u003c/h3\u003e\r\n                                    \u003cp\u003eIndustrial Connects\u003c/p\u003e\r\n                                \u003c/div\u003e\r\n                            \u003c/div\u003e\r\n                                                            \u003c/div\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n\u003c/section\u003e\r\n\r\n                                                                    \u003c/div\u003e\r\n                                                    \u003c/div\u003e\r\n                                    \u003c/div\u003e\r\n            \u003c/div\u003e\r\n\r\n                    \u003c/section\u003e\r\n            \r\n        \u003csection class=\"pb-themesection \"  \u003e\r\n            \r\n            \r\n            \r\n            \u003cdiv class=\"container-fluid\"\u003e\r\n                \u003cdiv class=\"row droppable-container\" data-id=\"3671aj0243\"\u003e\r\n                        