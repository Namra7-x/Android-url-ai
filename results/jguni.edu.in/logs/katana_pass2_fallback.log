n                        \u003ci class=\"fas fa-phone-alt\" style=\"color: #EA4B8B; font-size: 16px; margin-right: 8px;\"\u003e\u003c/i\u003e\r\n                        \u003cstrong\u003ePhone:\u003c/strong\u003e\u003cbr\u003e\r\n                        \u003ca href=\"tel:+917567756758\" style=\"color: #000; text-decoration: none;\"\u003e+91 7567 7567 58/59\u003c/a\u003e\r\n                    \u003c/p\u003e\r\n                \u003c/div\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n\u003c/div\u003e\r\n\r\n\u003c!-- Mandatory Disclosure and Footer Bottom --\u003e\r\n\u003cdiv class=\"row\"\u003e\r\n    \u003cdiv class=\"col-12 text-center\" style=\"margin-top: 30px; padding-top: 20px; border-top: 1px solid #C3C3C3;\"\u003e\r\n        \u003cp style=\"text-align: center; margin-bottom: 15px; font-size: 15px;\"\u003e\r\n            \u003ca href=\"https://jguni.edu.in/view-page/admissions\" style=\"color: #000; text-decoration: none;\"\u003eAdmissions\u003c/a\u003e | \u003ca href=\"https://jguni.edu.in/view-page/alumni-connect-cell\" style=\"color: #000; text-decoration: none;\"\u003eAlumni Connect Cell\u003c/a\u003e | \u003ca href=\"https://jguni.edu.in/view-page/mandatory-disclosre\" style=\"color: #000; text-decoration: none;\"\u003eMandatory Disclosure\u003c/a\u003e\r\n        \u003c/p\u003e\r\n        \u003cdiv style=\"display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 20px; font-size: 15px; line-height: 24px; margin-bottom: 10px; color: #000;\"\u003e\r\n            \u003cspan\u003eCopyright ©2022 JG University All Rights Reserved\u003c/span\u003e\r\n            \u003cspan\u003e\r\n                \u003ca href=\"https://jguni.edu.in/view-page/terms-and-conditions\" style=\"color: #000; text-decoration: none;\"\u003eTerms and Conditions\u003c/a\u003e | \u003ca href=\"https://jguni.edu.in/view-page/privacy-policy\" style=\"color: #000; text-decoration: none;\"\u003ePrivacy Policy\u003c/a\u003e | \u003ca href=\"https://jguni.edu.in/public/pdf/A_Handbook_on_Basics_of_Cyber_Hygiene.pdf\" style=\"color: #000; text-decoration: none;\"\u003eA Handbook on Basics of Cyber Hygiene\u003c/a\u003e\r\n            \u003c/span\u003e\r\n            \u003cspan\u003ePowered by: \u003ca href=\"https://n2nsolution.co/\" target=\"_blank\" style=\"color: #000; text-decoration: none;\"\u003eN2N Solutions\u003c/a\u003e\u003c/span\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n\u003c/div\u003e\r\n                                                                                                \u003c/div\u003e\r\n                                            \u003c/div\u003e\r\n                \u003c/div\u003e\r\n                                \u003c/section\u003e\r\n    \r\n        \u003c/main\u003e\r\n\r\n        \r\n        \u003c!-- background overlay --\u003e\r\n            \u003cdiv class=\"bg-shade\"\u003e\u003c/div\u003e\r\n        \u003c!-- background overlay --\u003e\r\n\r\n                    \u003cscript data-cfasync=\"false\" src=\"/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js\"\u003e\u003c/script\u003e\u003cscript src=\"https://jguni.edu.in/public/vendor/optionbuilder/js/jquery.min.js\"\u003e\u003c/script\u003e\r\n        \r\n                    \u003cscript defer src=\"https://jguni.edu.in/public/vendor/optionbuilder/js/bootstrap.min.js\"\u003e\u003c/script\u003e\r\n                \r\n        \r\n        \u003cscript\u003e\r\n            window._locale = 'en';\r\n            window._rtl = false;\r\n        \u003c/script\u003e\r\n        \u003cscript src=\"https://jguni.edu.in/public/theme/edulia/js/jquery.dataTables.min.js\"\u003e\u003c/script\u003e\r\n        \u003cscript src=\"https://jguni.edu.in/public/theme/edulia/js/dataTables.responsive.min.js\"\u003e\u003c/script\u003e\r\n        \u003cscript\u003e\r\n            $('body').append('\u003c!--back to top btn--\u003e\u003ca href=\"#\" class=\"backtop\"\u003e\u003ci class=\"far fa-long-arrow-alt-up\"\u003c/i\u003e');\r\n            $(window).on('scroll', function() {\r\n                var x = $(window).scrollTop();\r\n                if (x \u003e 700) {\r\n                    $('.backtop').addClass('show')\r\n                } else {\r\n                    $('.backtop').removeClass('show')\r\n                }\r\n            });\r\n            \r\n            $(\".common_data_table table\").DataTable({\r\n                responsive: true,\r\n                stripeClasses:[],\r\n                language: {\r\n                    searchPlaceholder: \"Search ...\",\r\n                    search: \"\u003ci class='far fa-search datatable-search'\u003e\u003c/i\u003e\",\r\n                },\r\n            });\r\n\r\n            $(window).on('scroll', function() {\r\n                var x = $(window).scrollTop();\r\n                if (x \u003e 500) {\r\n                    $('.heading_main').addClass('fixed-nav');\r\n                } else {\r\n                    $('.heading_main').removeClass('fixed-nav')\r\n\r\n                }\r\n            })\r\n        \u003c/script\u003e\r\n\r\n        \u003cscript src=\"https://jguni.edu.in/public/whatsapp-support/scripts.js\"\u003e\u003c/script\u003e\r\n            \u003cscript src=\"https://jguni.edu.in/public/theme/edulia/packages/carousel/owl.carousel.min.js\"\u003e\u003c/script\u003e\r\n    \u003cscript\u003e\r\n        $('.hero_area_slider').owlCarousel({\r\n            nav: true,\r\n            navText: ['\u003ci class=\"far fa-angle-left\"\u003e\u003c/i\u003e', '\u003ci class=\"far fa-angle-right\"\u003e\u003c/i\u003e'],\r\n            dots: false,\r\n            items: 1,\r\n            loop: true,\r\n            margin: 0,\r\n            autoplay: true,\r\n            autoplayTimeout: 5000,\r\n            autoplayHoverPause: true,\r\n        });\r\n    \u003c/script\u003e\r\n    \u003cscript src=\"https://jguni.edu.in/public/theme/edulia/packages/carousel/owl.carousel.min.js\"\u003e\u003c/script\u003e\r\n\u003cscript\u003e\r\n        $(document).ready(function() {\r\n            // Initialize carousel\r\n            var $carousel = $('.home_speech_section .owl-carousel');\r\n            var totalItems = $carousel.find('.single_speech_item').length;\r\n            \r\n            $carousel.owlCarousel({\r\n                nav: false,\r\n                navText: ['\u003ci class=\"far fa-angle-left\"\u003e\u003c/i\u003e', '\u003ci class=\"far fa-angle-right\"\u003e\u003c/i\u003e'],\r\n                dots: false,\r\n                items: 2,\r\n                loop: totalItems \u003e 2,\r\n                margin: 30,\r\n                autoplay: totalItems \u003e 2,\r\n                autoplayTimeout: 5000,\r\n                autoplayHoverPause: true,\r\n                responsive:{\r\n                    0: { items: 1, nav: false },\r\n                    576: { nav: true, items: 1 },\r\n                    767: { items: 2 },\r\n                    991: { items: 2 }\r\n                }\r\n            });\r\n            \r\n            // Handle view details button click\r\n            $(document).on('click', '.view-details-btn', function() {\r\n                // Get all data from data attributes\r\n                const image = $(this).data('image');\r\n                const name = $(this).data('name');\r\n                const designation = $(this).data('designation');\r\n                const title = $(this).data('title');\r\n                const content = $(this).data('content');\r\n                \r\n                // Populate modal\r\n                if(image) $('#modalSpeakerImage').attr('src', image);\r\n                if(name) $('#modalSpeakerName').text(name);\r\n                if(designation) $('#modalSpeakerDesignation').text(designation);\r\n                if(title) $('#modalSpeechTitle').text(title);\r\n                if(content) {\r\n                    $('#modalSpeechContent').html(content);\r\n                } else {\r\n                    $('#modalSpeechContent').html('\u003cp\u003eNo description available\u003c/p\u003e');\r\n                }\r\n                \r\n                // Show modal\r\n                $('#speechModal').modal('show');\r\n            });\r\n        });\r\n    \u003c/script\u003e\r\n    \u003cscript src=\"https://jguni.edu.in/public/theme/edulia/packages/animate-number/multi-animated-counter.min.js\"\u003e\u003c/script\u003e\r\n    \u003cscript src=\"https://jguni.edu.in/public/theme/edulia/packages/carousel/owl.carousel.min.js\"\u003e\u003c/script\u003e\r\n    \u003cscript\u003e\r\n        $('.tesimonials_slider').owlCarousel({\r\n            nav: false,\r\n            navText: ['\u003ci class=\"fal fa-angle-left\"\u003e\u003c/i\u003e', '\u003ci class=\"fal fa-angle-right\"\u003e\u003c/i\u003e'],\r\n            dots: true,\r\n            dotsData: true,\r\n            items: 1,\r\n            loop: true,\r\n            margin: 0,\r\n            autoplay: true,\r\n            autoplayTimeout: 3000,\r\n            autoplayHoverPause: true,\r\n        });\r\n    \u003c/script\u003e\r\n    \u003cscript src=\"https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js\"\u003e\u003c/script\u003e\n    \u003cscript\u003e\n        document.addEventListener('DOMContentLoaded', function() {\n            const partnersSwiper = new Swiper('.swiper.partners-swiper', {\n                slidesPerView: 2,\n                spaceBetween: 30,\n                loop: true,\n                speed: 600,\n                autoplay: {\n                    delay: 3000,\n                    disableOnInteraction: false,\n                    pauseOnMouseEnter: true,\n                },\n                pagination: {\n                    el: '.swiper-pagination',\n                    clickable: true,\n                },\n                breakpoints: {\n                    320: {\n                        slidesPerView: 2,\n                        spaceBetween: 30,\n                    },\n                    640: {\n                        slidesPerView: 3,\n                        spaceBetween: 30,\n                    },\n                    768: {\n                        slidesPerView: 4,\n                        spaceBetween: 30,\n                    },\n                    1024: {\n                        slidesPerView: 5,\n                        spaceBetween: 30,\n                    },\n                },\n            });\n        });\n    \u003c/script\u003e\n    \u003cscript src=\"https://jguni.edu.in/public/theme/edulia/packages/zeynep/zeynep.min.js\"\u003e\u003c/script\u003e\r\n    \u003cscript\u003e\r\n        /* ── Global nav helpers (must be global so front_master can call them) ── */\r\n        function jgNavOpen($li) {\r\n            $li.addClass('clicked-open');\r\n            $li.find('.mega-menu-dropdown').first().addClass('jg-open');\r\n            $li.find('\u003e ul.heading_main_menu_list_dropdown').addClass('jg-open');\r\n        }\r\n        function jgNavCloseAll() {\r\n            $('.heading_main_menu_list.clicked-open').each(function() {\r\n                $(this).removeClass('clicked-open');\r\n                $(this).find('.mega-menu-dropdown').first().removeClass('jg-open');\r\n                $(this).find('\u003e ul.heading_main_menu_list_dropdown').removeClass('jg-open');\r\n            });\r\n        }\r\n\r\n        $(document).ready(function(){\r\n            // MOBILE MENU ACTIVE JS\r\n            var zeynep = $('.zeynep').zeynep({})\r\n            $('.heading_mobile_thum').on('click', function() {\r\n                zeynep.open()\r\n                $('.bg-shade').fadeIn();\r\n            })\r\n            $('.bg-shade').on('click', function() {\r\n                zeynep.close()\r\n                $('.bg-shade').fadeOut();\r\n            })\r\n\r\n            $('[data-mobile-search]').on('click', function(e) {\r\n                e.stopPropagation();\r\n                $('.m_s').fadeToggle('fast')\r\n            });\r\n            $(document).on('click', function(e) {\r\n                if (!$(e.target).is('.m_s *')) {\r\n                    $('.m_s').fadeOut('fast')\r\n                }\r\n            })\r\n\r\n            $('.heading_main_search.desktop-search .heading_main_search_toggle').on('click', function(e) {\r\n                e.preventDefault();\r\n                e.stopPropagation();\r\n\r\n                var $form = $(this).closest('.heading_main_search.desktop-search');\r\n                var isOpen = $form.hasClass('is-open');\r\n\r\n                $('.heading_main_search.desktop-search').removeClass('is-open');\r\n                $('.heading_main_search.desktop-search .heading_main_search_toggle').attr('aria-expanded', 'false');\r\n\r\n                if (!isOpen) {\r\n                    $form.addClass('is-open');\r\n                    $(this).attr('aria-expanded', 'true');\r\n\r\n                    setTimeout(function() {\r\n                        $form.find('.input-control-input').trigger('focus');\r\n                    }, 180);\r\n                }\r\n            });\r\n\r\n            $('.heading_main_search.desktop-search').on('click', function(e) {\r\n                e.stopPropagation();\r\n            });\r\n\r\n            $('.heading_main_search.desktop-search .input-control-input').on('keydown', function(e) {\r\n                if (e.key === 'Escape') {\r\n                    var $form = $(this).closest('.heading_main_search.desktop-search');\r\n                    $form.removeClass('is-open');\r\n                    $form.find('.heading_main_search_toggle').attr('aria-expanded', 'false').trigger('focus');\r\n                }\r\n            });\r\n\r\n            $(document).on('click', function() {\r\n                $('.heading_main_search.desktop-search').removeClass('is-open');\r\n                $('.heading_main_search.desktop-search .heading_main_search_toggle').attr('aria-expanded', 'false');\r\n            });\r\n\r\n            /* ── Nav parent click-toggle ── */\r\n            $(document).off('click.jgNav').on('click.jgNav', '.heading_main_menu_list_link.has-children-toggle', function(e) {\r\n                e.preventDefault();\r\n                e.stopImmediatePropagation();\r\n                var $li = $(this).closest('.heading_main_menu_list');\r\n                var isOpen = $li.hasClass('clicked-open');\r\n                jgNavCloseAll();\r\n                if (!isOpen) {\r\n                    jgNavOpen($li);\r\n                }\r\n            });\r\n            // Close click-toggled menus when clicking outside nav\r\n            $(document).off('click.jgNavClose').on('click.jgNavClose', function(e) {\r\n                if (!$(e.target).closest('.heading_main_menu').length) {\r\n                    jgNavCloseAll();\r\n                }\r\n            });\r\n        });\r\n    \u003c/script\u003e\r\n\r\n        \u003cstyle\u003e\r\n            .messengerContainer:hover {\r\n                cursor: pointer;\r\n            }\r\n        \u003c/style\u003e\r\n        \r\n        \r\n                \r\n                \u003cscript\u003e\r\n            var position = '';\r\n            var tawkposition = '';\r\n        \r\n            if(position == 'left'){\r\n                tawkposition = 'bl';\r\n            }else{\r\n                tawkposition = 'br';\r\n            }\r\n            var Tawk_API = Tawk_API || {};\r\n        \r\n            Tawk_API.customStyle = {\r\n                visibility : {\r\n                    desktop : {\r\n                        position : tawkposition,\r\n                        xOffset : 0,\r\n                        yOffset : 20\r\n                    },\r\n                    mobile : {\r\n                        position : tawkposition,\r\n                        xOffset : 0,\r\n                        yOffset : 0\r\n                    },\r\n                    bubble : {\r\n                        rotate : '0deg',\r\n                         xOffset : -20,\r\n                         yOffset : 0\r\n                    }\r\n                }\r\n            };\r\n        \u003c/script\u003e\r\n\r\n                    \u003c!-- \u003cdiv id=\"admissionPopupOverlay\" class=\"admission-popup-overlay\" aria-hidden=\"true\"\u003e\r\n                \u003cdiv class=\"admission-popup-box\"\u003e\r\n                    \u003cbutton id=\"admissionPopupClose\" type=\"button\" class=\"admission-popup-close\" aria-label=\"Close\"\u003e\u0026times;\u003c/button\u003e\r\n                    \u003ca href=\"https://jguni.edu.in/view-page/admission-open\" aria-label=\"Admission Open\"\u003e\r\n                        \u003cimg class=\"admission-popup-image\" src=\"https://jguni.edu.in/public/images/images/26-27-admission.png\" alt=\"Admission 2026-27\"\u003e\r\n                    \u003c/a\u003e\r\n                \u003c/div\u003e\r\n            \u003c/div\u003e --\u003e\r\n\r\n            \u003cscript\u003e\r\n                (function () {\r\n                    var popupKey = 'admission_popup_2026_27_shown';\r\n                    var overlay = document.getElementById('admissionPopupOverlay');\r\n                    var closeBtn = document.getElementById('admissionPopupClose');\r\n                    if (!overlay || !closeBtn) {\r\n                        return;\r\n                    }\r\n\r\n                    var hasSeenPopup = false;\r\n                    try {\r\n                        hasSeenPopup = sessionStorage.getItem(popupKey) === '1';\r\n                    } catch (e) {\r\n                        hasSeenPopup = false;\r\n                    }\r\n\r\n                    if (!hasSeenPopup) {\r\n                        window.setTimeout(function () {\r\n                            overlay.style.display = 'flex';\r\n                            overlay.setAttribute('aria-hidden', 'false');\r\n                            try {\r\n                                sessionStorage.setItem(popupKey, '1');\r\n                            } catch (e) {\r\n                                // Ignore storage failures.\r\n                            }\r\n                        }, 800);\r\n                    }\r\n\r\n                    closeBtn.addEventListener('click', function () {\r\n                        overlay.style.display = 'none';\r\n                        overlay.setAttribute('aria-hidden', 'true');\r\n                    });\r\n\r\n                    overlay.addEventListener('click', function (event) {\r\n                        if (event.target === overlay) {\r\n                            overlay.style.display = 'none';\r\n                            overlay.setAttribute('aria-hidden', 'true');\r\n                        }\r\n                    });\r\n                })();\r\n            \u003c/script\u003e\r\n            \u003cscript type=\"module\" src=\"https://static.cloudflareinsights.com/beacon.min.js/vce701823e78c4301a35b7e07294d87301792088814092\" integrity=\"sha512-UKNk8GbxkABxKcXYuLkO16EleLGUkcvJWtpSNmExE0Too3ZaFAxTscNWEc1OdAv5/BikHawapSCaiD2XCmp+Bw==\" data-cf-beacon='{\"version\":\"2024.11.0\",\"token\":\"31c665abbed84cc181a9d549cb9b5d6d\",\"r\":1,\"spa\":2}' crossorigin=\"anonymous\"\u003e\u003c/script\u003e\n\u003c/body\u003e\r\n\u003c/html\u003e\r\n"}}
