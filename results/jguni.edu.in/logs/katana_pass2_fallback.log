_main_menu_list.clicked-open \u003e ul.heading_main_menu_list_dropdown {\r\n                    opacity: 1 !important;\r\n                    visibility: visible !important;\r\n                    pointer-events: auto !important;\r\n                    top: 100% !important;\r\n                }\r\n                .mega-menu-dropdown {\r\n                    opacity: 0 !important;\r\n                    visibility: hidden !important;\r\n                    pointer-events: none !important;\r\n                }\r\n                li.heading_main_menu_list.mega-menu-parent:hover .mega-menu-dropdown,\r\n                li.heading_main_menu_list.mega-menu-parent.clicked-open .mega-menu-dropdown {\r\n                    opacity: 1 !important;\r\n                    visibility: visible !important;\r\n                    pointer-events: auto !important;\r\n                }\r\n            }\r\n\r\n            /* Desktop nav items displayed in a horizontal row */\r\n            @media (min-width: 992px) {\r\n                nav.heading_main_menu \u003e ul {\r\n                    display: flex !important;\r\n                    flex-wrap: nowrap !important;\r\n                    align-items: center;\r\n                    list-style: none;\r\n                    margin: 0;\r\n                    padding: 0;\r\n                }\r\n                .heading_main_menu_list_link {\r\n                    white-space: nowrap !important;\r\n                    font-size: 0.8675em !important\r\n                }\r\n            }\r\n            @media (min-width: 992px) and (max-width: 1199px) {\r\n                .heading_main_menu_list_link {\r\n                    font-size: 0.75em !important;\r\n                    padding: 10px 6px !important;\r\n                }\r\n            }\r\n            @media (min-width: 1200px) and (max-width: 1439px) {\r\n                .heading_main_menu_list_link {\r\n                    font-size: 0.715em !important;\r\n                    paddin