              \u003c/section\u003e\r\n            \r\n        \u003csection class=\"pb-themesection \"  \u003e\r\n            \r\n            \r\n            \r\n            \u003cdiv class=\"container-fluid\"\u003e\r\n                \u003cdiv class=\"row droppable-container\" data-id=\"3671a89b4c\"\u003e\r\n                                            \u003cdiv class=\"col-12 p-0\"\u003e\r\n                                                            \r\n                                \u003cdiv class=\"\" \u003e\r\n                                                                            \u003cstyle\u003e\r\n    @media (max-width: 767px) {\r\n    .about_us .row \u003e div {\r\n        margin-bottom: 20px;\r\n    }\r\n    .about_us .row \u003e div:last-child {\r\n        margin-bottom: 0;\r\n    }\r\n}\r\n\u003c/style\u003e\r\n\u003csection class=\"section_padding about_us\"\u003e\r\n    \u003cdiv class=\"container\"\u003e\r\n        \u003cdiv class=\"row align-items-center\"\u003e\r\n            \u003c!-- Text content column - comes first on mobile --\u003e\r\n            \u003cdiv class=\"col-lg-6 col-md-6 order-lg-1 order-1\"\u003e\r\n                \u003cdiv class=\"about_us_inner about_us_home\"\u003e\r\n                    \u003ch3\u003eWelcome to JG University The Best University in Ahmedabad\u003c/h3\u003e\r\n                    \u003cp\u003e\u003cspan class=\" author-d-1gg9uz65z1iz85zgdz68zmqkz84zo2qowz80zsz78zz72zz122zz85zauz85zz84zz80zz65zz88zqj38z87zz67zez72ziz70zaaxz85zfsz81za\"\u003eJG University is a New Age Tech-Driven University offering programmes in Ahmedabad that evolve as per future industry demand, thus enabling its students to get into employment or self-employment seamlessly. It is a UGC approved University sponsored by the ASIA Charitable Trust, which has been in the field of education since 1965, successfully managing 17 colleges and 3 schools\u003c/span\u003e\u003c/p\u003e\r\n                                                                            \u003c/div\u003e\r\n            \u003c/div\u003e\r\n            \r\n            \u003c!-- Video column - comes second on mobile --\u003e\r\n            \u003cdiv class=\"col-lg-5 offset-lg-1 col-md-6 order-lg-2 order-2\"\u003e\r\n                                                                                \u003cdiv class=\"about_us_img\"\u003e\r\n                            \u003cdiv class=\"about_us_img_inner\" style=\"position:relative;padding-bottom:56.25%;height:0;overflow:hidden;\"\u003e\r\n                                \u003ciframe src=\"https://www.youtube.com/embed/uvV1q1rH07w\"\r\n                                    style=\"position:absolute;top:0;left:0;width:100%;height:100%;\"\r\n                                    frameborder=\"0\"\r\n                                    allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\r\n                                    allowfullscreen\u003e\r\n                                \u003c/iframe\u003e\r\n                            \u003c/div\u003e\r\n                        \u003c/div\u003e\r\n                                                \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n\u003c/section\u003e\r\n\r\n\u003csection class=\"strengths-section\" style=\"padding: 30px 0 40px 0; background: white; margin-bottom: 50px;\"\u003e\r\n  \u003cdiv class=\"container\"\u003e\r\n    \u003c!-- Main Heading --\u003e\r\n    \u003cdiv class=\"text-center mb-5\"\u003e\r\n      \u003ch2 style=\"font-size: 36px; font-weight: 700; color: #222; margin-bottom: 20px;\"\u003eOur Strengths\u003c/h2\u003e\r\n      \u003cdiv style=\"width: 80px; height: 4px; background: #cb0003; margin: 0 auto;\"\u003e\u003c/div\u003e\r\n    \u003c/div\u003e\r\n\r\n    \u003c!-- Strengths Grid - Centered Content --\u003e\r\n    \u003cdiv class=\"row\"\u003e\r\n      \u003c!-- Strength 1 --\u003e\r\n      \u003cdiv class=\"col-md-6 col-lg-3 mb-4\"\u003e\r\n        \u003cdiv style=\"border: 1px solid #e0e0e0; padding: 30px; height: 100%; text-align: center;\"\u003e\r\n          \u003c!-- Image Container --\u003e\r\n          \u003cdiv style=\"width: 80px; height: 80px; background: #EA4B8B; margin: 0 auto 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center;\"\u003e\r\n            \u003cimg src=\"https://jguni.edu.in/public/images/images/opportunities.png\" alt=\"Interdisciplinary\" style=\"width: 40px; height: 40px;\"\u003e\r\n          \u003c/div\u003e\r\n          \u003ch3 style=\"font-size: 20px; font-weight: 600; color: #222; margin-bottom: 15px;\"\u003e\r\n            Interdisciplinary Approach\r\n          \u003c/h3\u003e\r\n          \u003cp style=\"color: #555; line-height: 1.6; font-size: 15px; margin: 0 auto; max-width: 240px;\"\u003e\r\n            Students from a wide range of backgrounds connect, ideate and solve problems with different conceptual structures and methods of understanding\r\n          \u003c/p\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n\r\n      \u003c!-- Strength 2 --\u003e\r\n      \u003cdiv class=\"col-md-6 col-lg-3 mb-4\"\u003e\r\n        \u003cdiv style=\"border: 1px solid #e0e0e0; padding: 30px; height: 100%; text-align: center;\"\u003e\r\n          \u003c!-- Image Container --\u003e\r\n          \u003cdiv style=\"width: 80px; height: 80px; background: #7F59B0; margin: 0 auto 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center;\"\u003e\r\n            \u003cimg src=\"https://jguni.edu.in/public/images/images/mortarboard.png\" alt=\"Experiential Learning\" style=\"width: 40px; height: 40px;\"\u003e\r\n          \u003c/div\u003e\r\n          \u003ch3 style=\"font-size: 20px; font-weight: 600; color: #222; margin-bottom: 15px;\"\u003e\r\n            Immersive \u0026 Experiential Learning\r\n          \u003c/h3\u003e\r\n          \u003cp style=\"color: #555; line-height: 1.6; font-size: 15px; margin: 0 auto; max-width: 240px;\"\u003e\r\n            Exposure to real-life projects to develop hands-on expertise\r\n          \u003c/p\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n\r\n      \u003c!-- Strength 3 --\u003e\r\n      \u003cdiv class=\"col-md-6 col-lg-3 mb-4\"\u003e\r\n        \u003cdiv style=\"border: 1px solid #e0e0e0; padding: 30px; height: 100%; text-align: center;\"\u003e\r\n          \u003c!-- Image Container --\u003e\r\n          \u003cdiv style=\"width: 80px; height: 80px; background: #4FC4F1; margin: 0 auto 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center;\"\u003e\r\n            \u003cimg src=\"https://jguni.edu.in/public/images/images/learning.png\" alt=\"Brain Learning\" style=\"width: 40px; height: 40px;\"\u003e\r\n          \u003c/div\u003e\r\n          \u003ch3 style=\"font-size: 20px; font-weight: 600; color: #222; margin-bottom: 15px;\"\u003e\r\n            Whole Brain Learning Pedagogy\r\n          \u003c/h3\u003e\r\n          \u003cp style=\"color: #555; line-height: 1.6; font-size: 15px; margin: 0 auto; max-width: 240px;\"\u003e\r\n            Pedagogy that empower learners to acquire future-proof technical skills and moulds them into creative thinkers\r\n          \u003c/p\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n\r\n      \u003c!-- Strength 4 --\u003e\r\n      \u003cdiv class=\"col-md-6 col-lg-3 mb-4\"\u003e\r\n        \u003cdiv style=\"border: 1px solid #e0e0e0; padding: 30px; height: 100%; text-align: center;\"\u003e\r\n          \u003c!-- Image Container --\u003e\r\n          \u003cdiv style=\"width: 80px; height: 80px; background: #FCB424; margin: 0 auto 20px; border-radius: 50%; display: flex; align-items: center; justify-content: center;\"\u003e\r\n            \u003cimg src=\"https://jguni.edu.in/public/images/images/presentation.png\" alt=\"Faculty\" style=\"width: 40px; height: 40px;\"\u003e\r\n          \u003c/div\u003e\r\n          \u003ch3 style=\"font-size: 20px; font-weight: 600; color: #222; margin-bottom: 15px;\"\u003e\r\n            Faculty from Academia \u0026 Industry\r\n          \u003c/h3\u003e\r\n          \u003cp style=\"color: #555; line-height: 1.6; font-size: 15px; margin: 0 auto; max-width: 240px;\"\u003e\r\n            Inspiration by dynamic, brilliant scholars with vast academic knowledge and real-world experience\r\n          \u003c/p\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n    \u003c/div\u003e\r\n  \u003c/div\u003e\r\n\u003c/section\u003e\r\n\r\n\r\n\u003cstyle\u003e\r\n  .jg-tech-section {\r\n    background: linear-gradient(135deg, #00124e 0%, #0a1f6e 60%, #1a2f80 100%);\r\n    padding: 70px 0 60px;\r\n    position: relative;\r\n    overflow: hidden;\r\n  }\r\n  .jg-tech-section::before {\r\n    content: '';\r\n    position: absolute;\r\n    top: -80px;\r\n    right: -80px;\r\n    width: 320px;\r\n    height: 320px;\r\n    border-radius: 50%;\r\n    background: rgba(255,255,255,0.04);\r\n    pointer-events: none;\r\n  }\r\n  .jg-tech-section::after {\r\n    content: '';\r\n    position: absolute;\r\n    bottom: -60px;\r\n    left: -60px;\r\n    width: 240px;\r\n    height: 240px;\r\n    border-radius: 50%;\r\n    background: rgba(151,16,30,0.12);\r\n    pointer-events: none;\r\n  }\r\n  .jg-tech-eyebrow {\r\n    display: inline-block;\r\n    background: rgba(151,16,30,0.85);\r\n    color: #fff;\r\n    font-size: 12px;\r\n    font-weight: 700;\r\n    letter-spacing: 2.5px;\r\n    text-transform: uppercase;\r\n    padding: 6px 18px;\r\n    border-radius: 20px;\r\n    margin-bottom: 18px;\r\n  }\r\n  .jg-tech-heading {\r\n    font-size: 36px;\r\n    font-weight: 800;\r\n    color: #ffffff;\r\n    margin-bottom: 12px;\r\n    line-height: 1.25;\r\n  }\r\n  @media (max-width: 767px) {\r\n    .jg-tech-heading { font-size: 26px; }\r\n  }\r\n  .jg-tech-divider {\r\n    width: 60px;\r\n    height: 4px;\r\n    background: #97101e;\r\n    border-radius: 2px;\r\n    margin: 0 auto 50px;\r\n  }\r\n  .jg-tech-feature {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 20px;\r\n    background: rgba(255, 255, 255, 0.06);\r\n    border: 1px solid rgba(255, 255, 255, 0.1);\r\n    border-radius: 12px;\r\n    padding: 28px 24px;\r\n    margin-bottom: 24px;\r\n    transition: background 0.25s ease, transform 0.25s ease, border-color 0.25s ease;\r\n    position: relative;\r\n    z-index: 1;\r\n    align-content: stretch;\r\n    justify-content: space-between;\r\n    flex-direction: column;\r\n  }\r\n  .jg-tech-feature:hover {\r\n    background: rgba(255,255,255,0.11);\r\n    border-color: rgba(151,16,30,0.55);\r\n    transform: translateY(-3px);\r\n  }\r\n  .jg-tech-icon {\r\n    flex-shrink: 0;\r\n    width: 54px;\r\n    height: 54px;\r\n    border-radius: 12px;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    font-size: 22px;\r\n    color: #fff;\r\n  }\r\n  .jg-tech-icon.ic-wifi   { background: linear-gradient(135deg, #0274b3, #03a9f4); }\r\n  .jg-tech-icon.ic-class  { background: linear-gradient(135deg, #7f59b0, #b388ff); }\r\n  .jg-tech-icon.ic-ai     { background: linear-gradient(135deg, #97101e, #d51b01); }\r\n  .jg-tech-icon.ic-lab    { background: linear-gradient(135deg, #1b8a5a, #43c98a); }\r\n  .jg-tech-feature-title {\r\n    font-size: 17px;\r\n    font-weight: 700;\r\n    color: #ffffff;\r\n    margin-bottom: 6px;\r\n    line-height: 1.3;\r\n  }\r\n  .jg-tech-feature-desc {\r\n    font-size: 14px;\r\n    color: rgba(255,255,255,0.7);\r\n    line-height: 1.6;\r\n    margin: 0;\r\n  }\r\n  .jg-tech-ecosystem {\r\n    margin-top: 48px;\r\n    border-top: 1px solid rgba(255,255,255,0.12);\r\n    padding-top: 40px;\r\n    text-align: center;\r\n    position: relative;\r\n    z-index: 1;\r\n  }\r\n  .jg-tech-ecosystem-icon {\r\n    width: 72px;\r\n    height: 72px;\r\n    background: rgba(151,16,30,0.8);\r\n    border-radius: 50%;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    margin: 0 auto 20px;\r\n    font-size: 28px;\r\n    color: #fff;\r\n  }\r\n  .jg-tech-ecosystem-title {\r\n    font-size: 28px;\r\n    font-weight: 800;\r\n    color: #ffffff;\r\n    margin-bottom: 10px;\r\n    letter-spacing: 0.5px;\r\n  }\r\n  .jg-tech-ecosystem-sub {\r\n    font-size: 15px;\r\n    color: rgba(255,255,255,0.65);\r\n    max-width: 480px;\r\n    margin: 0 auto;\r\n    line-height: 1.7;\r\n  }\r\n  @media (max-width: 767px) {\r\n    .jg-tech-section { padding: 50px 0 44px; }\r\n    .jg-tech-ecosystem-title { font-size: 22px; }\r\n  }\r\n\u003c/style\u003e\r\n\r\n\u003csection class=\"jg-tech-section\"\u003e\r\n  \u003cdiv class=\"container\"\u003e\r\n\r\n    \r\n    \u003cdiv class=\"text-center\"\u003e\r\n      \u003cspan class=\"jg-tech-eyebrow\"\u003eGujarat's Tech-Driven Campus\u003c/span\u003e\r\n      \u003ch2 class=\"jg-tech-heading\"\u003eWhat Makes Us A Tech-Driven University?\u003c/h2\u003e\r\n      \u003cdiv class=\"jg-tech-divider\"\u003e\u003c/div\u003e\r\n    \u003c/div\u003e\r\n\r\n    \r\n    \u003cdiv class=\"row justify-content-center\" style=\"position:relative;z-index:1;\"\u003e\r\n\r\n      \r\n      \u003cdiv class=\"col-md-6 col-lg-5 mx-lg-2\"\u003e\r\n        \u003cdiv class=\"jg-tech-feature\"\u003e\r\n          \u003cdiv class=\"jg-tech-icon ic-ai\"\u003e\r\n            \u003ci class=\"fas fa-brain\"\u003e\u003c/i\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv\u003e\r\n            \u003cp class=\"jg-tech-feature-title\"\u003eAI-Powered Learning Management System\u003c/p\u003e\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n\r\n      \r\n      \u003cdiv class=\"col-md-6 col-lg-5 mx-lg-2\"\u003e\r\n        \u003cdiv class=\"jg-tech-feature\"\u003e\r\n          \u003cdiv class=\"jg-tech-icon ic-lab\"\u003e\r\n            \u003ci class=\"fas fa-book-open\"\u003e\u003c/i\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv\u003e\r\n            \u003cp class=\"jg-tech-feature-title\"\u003eDigital Library\u003c/p\u003e\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n\r\n      \r\n      \u003cdiv class=\"col-md-6 col-lg-5 mx-lg-2\"\u003e\r\n        \u003cdiv class=\"jg-tech-feature\"\u003e\r\n          \u003cdiv class=\"jg-tech-icon ic-class\"\u003e\r\n            \u003ci class=\"fas fa-cloud\"\u003e\u003c/i\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv\u003e\r\n            \u003cp class=\"jg-tech-feature-title\"\u003eCloud Computing Infrastructure\u003c/p\u003e\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n\r\n\r\n      \r\n      \u003cdiv class=\"col-md-6 col-lg-5 mx-lg-2\"\u003e\r\n        \u003cdiv class=\"jg-tech-feature\"\u003e\r\n          \u003cdiv class=\"jg-tech-icon ic-wifi\"\u003e\r\n            \u003ci class=\"fas fa-wifi\"\u003e\u003c/i\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv\u003e\r\n            \u003cp class=\"jg-tech-feature-title\"\u003eWi-Fi Enable Campus\u003c/p\u003e\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n\r\n      \r\n      \u003cdiv class=\"col-md-6 col-lg-5 mx-lg-2\"\u003e\r\n        \u003cdiv class=\"jg-tech-feature\"\u003e\r\n          \u003cdiv class=\"jg-tech-icon ic-class\"\u003e\r\n            \u003ci class=\"fas fa-chalkboard-teacher\"\u003e\u003c/i\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv\u003e\r\n            \u003cp class=\"jg-tech-feature-title\"\u003eSmart Classrooms\u003c/p\u003e\r\n            \r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n\r\n      \r\n      \u003cdiv class=\"col-md-6 col-lg-5 mx-lg-2\"\u003e\r\n        \u003cdiv class=\"jg-tech-feature\"\u003e\r\n          \u003cdiv class=\"jg-tech-icon ic-ai\"\u003e\r\n            \u003ci class=\"fas fa-brain\"\u003e\u003c/i\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv\u003e\r\n            \u003cp class=\"jg-tech-feature-title\"\u003eAI-Integrated Curriculum\u003c/p\u003e\r\n            \r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n\r\n      \r\n      \u003cdiv class=\"col-md-6 col-lg-5 mx-lg-2\"\u003e\r\n        \u003cdiv class=\"jg-tech-feature\"\u003e\r\n          \u003cdiv class=\"jg-tech-icon ic-lab\"\u003e\r\n            \u003ci class=\"fas fa-flask\"\u003e\u003c/i\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv\u003e\r\n            \u003cp class=\"jg-tech-feature-title\"\u003eIndustry-Connected Labs\u003c/p\u003e\r\n            \r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n      \u003c/div\u003e\r\n\r\n    \u003c/div\u003e\r\n\r\n    \r\n    \u003cdiv class=\"jg-tech-ecosystem\"\u003e\r\n      \u003cdiv class=\"jg-tech-ecosystem-icon\"\u003e\r\n        \u003ci class=\"fas fa-microchip\"\u003e\u003c/i\u003e\r\n      \u003c/div\u003e\r\n      \u003ch3 class=\"jg-tech-ecosystem-title\"\u003eThe JG Tech Ecosystem\u003c/h3\u003e\r\n    \u003c/div\u003e\r\n\r\n    \r\n    \u003cdiv class=\"jg-ecosystem-swiper-wrap\"\u003e\r\n      \u003cdiv class=\"swiper jg-ecosystem-swiper\"\u003e\r\n        \u003cdiv class=\"swiper-wrapper\"\u003e\r\n          \u003cdiv class=\"swiper-slide\"\u003e\u003cimg src=\"https://jguni.edu.in/public/images/JG%20Tech%20Ecosystem/IMG_0091.jpeg\" alt=\"JG Tech Ecosystem\" class=\"jg-eco-img\"\u003e\u003c/div\u003e\r\n          \u003c!--\u003cdiv class=\"swiper-slide\"\u003e\u003cimg src=\"https://jguni.edu.in/public/images/JG%20Tech%20Ecosystem/IMG_0092.jpeg\" alt=\"JG Tech Ecosystem\" class=\"jg-eco-img\"\u003e\u003c/div\u003e--\u003e\r\n          \u003c!--\u003cdiv class=\"swiper-slide\"\u003e\u003cimg src=\"https://jguni.edu.in/public/images/JG%20Tech%20Ecosystem/IMG_0094.jpeg\" alt=\"JG Tech Ecosystem\" class=\"jg-eco-img\"\u003e\u003c/div\u003e--\u003e\r\n          \u003cdiv class=\"swiper-slide\"\u003e\u003cimg src=\"https://jguni.edu.in/public/images/JG%20Tech%20Ecosystem/IMG_0095.jpeg\" alt=\"JG Tech Ecosystem\" class=\"jg-eco-img\"\u003e\u003c/div\u003e\r\n          \u003cdiv class=\"swiper-slide\"\u003e\u003cimg src=\"https://jguni.edu.in/public/images/JG%20Tech%20Ecosystem/IMG_0113.jpeg\" alt=\"JG Tech Ecosystem\" class=\"jg-eco-img\"\u003e\u003c/div\u003e\r\n          \u003cdiv class=\"swiper-slide\"\u003e\u003cimg src=\"https://jguni.edu.in/public/images/JG%20Tech%20Ecosystem/IMG_0116.jpeg\" alt=\"JG Tech Ecosystem\" class=\"jg-eco-img\"\u003e\u003c/div\u003e\r\n          \u003cdiv class=\"swiper-slide\"\u003e\u003cimg src=\"https://jguni.edu.in/public/images/JG%20Tech%20Ecosystem/IMG_0126.jpeg\" alt=\"JG Tech Ecosystem\" class=\"jg-eco-img\"\u003e\u003c/div\u003e\r\n          \u003cdiv class=\"swiper-slide\"\u003e\u003cimg src=\"https://jguni.edu.in/public/images/JG%20Tech%20Ecosystem/IMG_0144.jpeg\" alt=\"JG Tech Ecosystem\" class=\"jg-eco-img\"\u003e\u003c/div\u003e\r\n          \u003cdiv class=\"swiper-slide\"\u003e\u003cimg src=\"https://jguni.edu.in/public/images/JG%20Tech%20Ecosystem/Untitled%20design.jpg.jpeg\" alt=\"JG Tech Ecosystem\" class=\"jg-eco-img\"\u003e\u003c/div\u003e\r\n          \u003cdiv class=\"swiper-slide\"\u003e\u003cimg src=\"https://jguni.edu.in/public/images/JG%20Tech%20Ecosystem/Untitled%20design%20(1).jpg.jpeg\" alt=\"JG Tech Ecosystem\" class=\"jg-eco-img\"\u003e\u003c/div\u003e\r\n          \u003cdiv class=\"swiper-slide\"\u003e\u003cimg src=\"https://jguni.edu.in/public/images/JG%20Tech%20Ecosystem/Untitled%20design%20(2).jpg.jpeg\" alt=\"JG Tech Ecosystem\" class=\"jg-eco-img\"\u003e\u003c/div\u003e\r\n          \u003cdiv class=\"swiper-slide\"\u003e\u003cimg src=\"https://jguni.edu.in/public/images/JG%20Tech%20Ecosystem/Untitled%20design%20(3).jpg.jpeg\" alt=\"JG Tech Ecosystem\" class=\"jg-eco-img\"\u003e\u003c/div\u003e\r\n          \u003cdiv class=\"swiper-slide\"\u003e\u003cimg src=\"https://jguni.edu.in/public/images/JG%20Tech%20Ecosystem/Untitled%20design%20(4).jpg.jpeg\" alt=\"JG Tech Ecosystem\" class=\"jg-eco-img\"\u003e\u003c/div\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"swiper-pagination jg-eco-pagination\"\u003e\u003c/div\u003e\r\n        \u003cdiv class=\"swiper-button-prev jg-eco-btn-prev\"\u003e\u003c/div\u003e\r\n        \u003cdiv class=\"swiper-button-next jg-eco-btn-next\"\u003e\u003c/div\u003e\r\n      \u003c/div\u003e\r\n    \u003c/div\u003e\r\n\r\n    \u003cstyle\u003e\r\n      .jg-ecosystem-swiper-wrap {\r\n        margin-top: 40px;\r\n        position: relative;\r\n        z-index: 1;\r\n        padding: 0 50px 48px;\r\n      }\r\n      .jg-ecosystem-swiper {\r\n        border-radius: 12px;\r\n        overflow: hidden;\r\n      }\r\n      .jg-eco-img {\r\n        width: 100%;\r\n        height: 280px;\r\n        object-fit: cover;\r\n        display: block;\r\n        border-radius: 10px;\r\n      }\r\n      .jg-eco-pagination .swiper-pagination-bullet {\r\n        background: rgba(255,255,255,0.45);\r\n        opacity: 1;\r\n      }\r\n      .jg-eco-pagination .swiper-pagination-bullet-active {\r\n        background: #ffffff;\r\n      }\r\n      .jg-eco-btn-prev,\r\n      .jg-eco-btn-next {\r\n        color: #ffffff;\r\n        background: rgba(151,16,30,0.75);\r\n        width: 40px;\r\n        height: 40px;\r\n        border-radius: 50%;\r\n        transition: background 0.2s ease;\r\n      }\r\n      .jg-eco-btn-prev:hover,\r\n      .jg-eco-btn-next:hover {\r\n        background: rgba(151,16,30,1);\r\n      }\r\n      .jg-eco-btn-prev::after,\r\n      .jg-eco-btn-next::after {\r\n        font-size: 14px;\r\n        font-weight: 700;\r\n      }\r\n      @media (max-width: 576px) {\r\n        .jg-ecosystem-swiper-wrap { padding: 0 40px 40px; }\r\n        .jg-eco-img { height: 200px; }\r\n      }\r\n    \u003c/style\u003e\r\n\r\n    \u003cscript\u003e\r\n      document.addEventListener('DOMContentLoaded', function () {\r\n        var ecoEl = document.querySelector('.jg-ecosystem-swiper');\r\n        if (ecoEl \u0026\u0026 typeof Swiper !== 'undefined') {\r\n          new Swiper(ecoEl, {\r\n            slidesPerView: 1,\r\n            spaceBetween: 16,\r\n            loop: true,\r\n            autoplay: { delay: 3000, disableOnInteraction: false },\r\n            pagination: { el: ecoEl.querySelector('.jg-eco-pagination'), clickable: true },\r\n            navigation: {\r\n              prevEl: ecoEl.querySelector('.jg-eco-btn-prev'),\r\n              nextEl: ecoEl.querySelector('.jg-eco-btn-next')\r\n            },\r\n            breakpoints: {\r\n              576: { slidesPerView: 2, spaceBetween: 16 },\r\n              992: { slidesPerView: 3, spaceBetween: 20 }\r\n            }\r\n          });\r\n        }\r\n      });\r\n    \u003c/script\u003e\r\n\r\n  \u003c/div\u003e\r\n\u003c/section\u003e\r\n\r\n                                                                    \u003c/div\u003e\r\n                                                    \u003c/div\u003e\r\n                                    \u003c/div\u003e\r\n            \u003c/div\u003e\r\n\r\n                    \u003c/section\u003e\r\n            \r\n        \u003csection class=\"pb-themesection \"  \u003e\r\n            \r\n            \r\n            \r\n            \u003cdiv class=\"container-fluid\"\u003e\r\n                \u003cdiv class=\"row droppable-container\" data-id=\"3671ai4i0f\"\u003e\r\n                                            \u003cdiv class=\"col-12 p-0\"\u003e\r\n                                                            \r\n                                \u003cdiv class=\"\" \u003e\r\n                                                                            \u003cdiv class=\"tmp-services pb-spacer\" style=\"height: px; width: 100%\"\u003e\u003c/div\u003e\r\n                                                                    \u003c/div\u003e\r\n                                                            \r\n                                \u003cdiv class=\"\" \u003e\r\n                                                                            \u003cdiv class=\"tmp-services pb-spacer\" style=\"height: px; width: 100%\"\u003e\u003c/div\u003e\r\n                                                                    \u003c/div\u003e\r\n                                                            \r\n                                \u003cdiv class=\"\" \u003e\r\n                                                                            \u003cstyle\u003e\r\n    .programmes-section { padding: 50px 0; }\r\n    .programmes-section .title { position: relative; margin-bottom: 30px; display: block; }\r\n    .programmes-section .title h1 { font-size: 2rem; font-weight: 700; color: #222; }\r\n    .pro-box { position: relative; overflow: hidden; margin-bottom: 20px; cursor: pointer; }\r\n    .pro-box img { width: 100%; display: block; }\r\n    .hover-box {\r\n        background-color: #97101E;\r\n        padding: 12px;\r\n        position: absolute;\r\n        bottom: 0; left: 0;\r\n        width: 100%;\r\n        height: 50px;\r\n        overflow: hidden;\r\n        transition: height 0.5s ease-in-out;\r\n        -webkit-transition: height 0.5s ease-in-out;\r\n    }\r\n    .hover-box.expanded { overflow-y: auto; }\r\n    .pink-bg   { background-color: #EA4B8B; }\r\n    .purple-bg { background-color: #7F59B0; }\r\n    .blue-bg   { background-color: #4FC4F1; }\r\n    .red-bg    { background-color: #97101E; }\r\n    .hover-box h3 { color: #fff; text-align: center; margin-bottom: 15px; font-size: 1.2rem; font-weight: 700; }\r\n    .hover-box ul { padding-left: 16px; margin-bottom: 0; }\r\n    .hover-box ul li { color: #fff; padding-bottom: 8px; line-height: 22px; font-size: 0.85rem; }\r\n    .hover-box ul li a { color: #fff; text-decoration: none; }\r\n    .hover-box ul li a:hover { color: #fff; text-decoration: underline; }\r\n    @media (max-width: 767px) {\r\n        .programmes-section .pro-box .hover-box {\r\n            position: relative !important;\r\n            height: auto !important;\r\n            overflow: hidden !important;\r\n            bottom: auto !important;\r\n        }\r\n        .programmes-section .pro-box .hover-box ul {\r\n            max-height: 0 !important;\r\n            overflow: hidden !important;\r\n            transition: max-height 0.4s ease-in-out;\r\n            padding: 0 !important;\r\n            margin: 0 !important;\r\n        }\r\n        .programmes-section .pro-box .hover-box.mobile-expanded ul {\r\n            max-height: 5000px !important;\r\n            padding-left: 16px !important;\r\n        }\r\n        .programmes-section .pro-box .hover-box h3 {\r\n            cursor: pointer;\r\n            margin-bottom: 0 !important;\r\n            padding: 8px 0;\r\n            user-select: none;\r\n        }\r\n        .programmes-section .pro-box .hover-box.mobile-expanded h3 {\r\n            margin-bottom: 15px !important;\r\n        }\r\n        .programmes-section .pro-box .hover-box h3::after {\r\n            content: '\\25BC';\r\n            font-size: 0.7rem;\r\n            margin-left: 8px;\r\n            transition: transform 0.3s ease;\r\n            display: inline-block;\r\n        }\r\n        .programmes-section .pro-box .hover-box.mobile-expanded h3::after {\r\n            transform: rotate(180deg);\r\n        }\r\n    }\r\n\u003c/style\u003e\r\n\r\n\u003csection class=\"programmes-section\"\u003e\r\n    \u003cdiv class=\"container\"\u003e\r\n        \u003cdiv class=\"title\"\u003e\r\n            \u003ch1\u003eProgrammes\u003c/h1\u003e\r\n        \u003c/div\u003e\r\n        \u003cdiv class=\"row\"\u003e\r\n            \u003c!-- Undergraduate --\u003e\r\n            \u003cdiv class=\"col-md-6 col-lg-4\"\u003e\r\n                \u003cdiv class=\"pro-box\"\u003e\r\n                    \u003cimg class=\"img-fluid\" src=\"https://jguni.edu.in/public/images/images/ug-programmes.jpg\" loading=\"lazy\" width=\"450\" height=\"450\" style=\"max-width: 100%; height: auto;\