ull viewport width */\r\n    width: 100vw;\r\n    position: relative;\r\n    left: 50%;\r\n    margin-left: -50vw;\r\n    overflow: hidden;\r\n    background-color: rgba(176, 10, 10, 0.88);\r\n    padding: 9px 0;\r\n    z-index: 200;\r\n}\r\n.achievement-ticker-inner {\r\n    display: inline-flex;\r\n    min-width: max-content;\r\n    white-space: nowrap;\r\n    animation: achievementScroll 30s linear infinite;\r\n    will-change: transform;\r\n}\r\n.achievement-ticker-inner:hover {\r\n    animation-play-state: paused;\r\n}\r\n.achievement-ticker-set {\r\n    display: flex;\r\n    flex-shrink: 0;\r\n    align-items: center;\r\n    white-space: nowrap;\r\n}\r\n.achievement-item {\r\n    display: inline-block;\r\n    color: #fff;\r\n    font-size: 13.5px;\r\n    font-weight: 500;\r\n    letter-spacing: 0.02em;\r\n    padding: 0 22px;\r\n    white-space: nowrap;\r\n}\r\n.achievement-sep {\r\n    color: #ffd700;\r\n    font-size: 16px;\r\n    line-height: 1;\r\n    flex-shrink: 0;\r\n}\r\n@keyframes achievementScroll {\r\n    0%   { transform: translateX(0); }\r\n    100% { transform: translateX(-50%); }\r\n}\r\n@media (max-width: 767px) {\r\n    .achievement-ticker-wrap {\r\n        position: fixed;\r\n        top: 0;\r\n        left: 50%;\r\n        margin-left: -50vw;\r\n        width: 100vw;\r\n        z-index: 9999;\r\n        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);\r\n    }\r\n    .achievement-ticker-inner {\r\n        animation-duration: 60s;\r\n    }\r\n    .achievement-item {\r\n        font-size: 12px;\r\n        padding: 0 16px;\r\n    }\r\n    .heading {\r\n        margin-top: 46px;\r\n    }\r\n}\r\n\u003c/style\u003e\r\n\r\n\u003cdiv class=\"achievement-ticker-wrap\"\u003e\r\n    \u003cdiv class=\"achievement-ticker-inner\"\u003e\r\n        \r\n        \u003cdiv class=\"achievement-ticker-set\"\u003e\r\n            \u003cspan class=\"achievement-item\"\u003eExcellence in Academic Achievement \u0026mdash; Education World 2026 \u0026nbsp;\u0026bull;\u0026