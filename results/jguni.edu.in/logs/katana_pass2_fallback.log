                        \u003c/svg\u003e\u003c/i\u003e\r\n                                    \u003ci\u003e\u003csvg xmlns=\"http://www.w3.org/2000/svg\" width=\"19.021\" height=\"18.09\"\r\n                            viewBox=\"0 0 19.021 18.09\"\u003e\r\n                            \u003cpath id=\"Path_734\" data-name=\"Path 734\"\r\n                                d=\"M12,17,6.122,20.59l1.6-6.7L2.49,9.41l6.865-.55L12,2.5l2.645,6.36,6.866.55L16.28,13.89l1.6,6.7Z\"\r\n                                transform=\"translate(-2.49 -2.5)\" fill=\"#4068fc\" /\u003e\r\n                        \u003c/svg\u003e\u003c/i\u003e\r\n                                    \u003ci\u003e\u003csvg xmlns=\"http://www.w3.org/2000/svg\" width=\"19.021\" height=\"18.09\"\r\n                            viewBox=\"0 0 19.021 18.09\"\u003e\r\n                            \u003cpath id=\"Path_734\" data-name=\"Path 734\"\r\n                                d=\"M12,17,6.122,20.59l1.6-6.7L2.49,9.41l6.865-.55L12,2.5l2.645,6.36,6.866.55L16.28,13.89l1.6,6.7Z\"\r\n                                transform=\"translate(-2.49 -2.5)\" fill=\"#4068fc\" /\u003e\r\n                        \u003c/svg\u003e\u003c/i\u003e\r\n                                    \u003ci\u003e\u003csvg xmlns=\"http://www.w3.org/2000/svg\" width=\"19.021\" height=\"18.09\"\r\n                            viewBox=\"0 0 19.021 18.09\"\u003e\r\n                            \u003cpath id=\"Path_734\" data-name=\"Path 734\"\r\n                                d=\"M12,17,6.122,20.59l1.6-6.7L2.49,9.41l6.865-.55L12,2.5l2.645,6.36,6.866.55L16.28,13.89l1.6,6.7Z\"\r\n                                transform=\"translate(-2.49 -2.5)\" fill=\"#4068fc\" /\u003e\r\n                        \u003c/svg\u003e\u003c/i\u003e\r\n                                    \u003ci\u003e\u003csvg xmlns=\"http://www.w3.org/2000/svg\" width=\"19.021\" height=\"18.09\"\r\n                            viewBox=\"0 0 19.021 18.09\"\u003e\r\n                            \u003cpath id=\"Path_734\" data-name=\"Path 734\"\r\n                                d=\"M12,17,6.122,20.59l1.6-6.7L2.49,9.41l6.865-.55L12,2.5l2.645,6.36,6.866.55L16.28,13.89l1.6,6.7Z\"\r\n                                transform=\"translate(-2.49 -2.5)\" fill=\"#4068fc\" /\u003e\r\n                        \u003c/svg\u003e\u003c/i\u003e\r\n                                            \u003c/div\u003e\r\n            \u003ch3\u003e“ I owe my success as a business owner to JG. Its focus on entrepreneurship and innovation inspired... ”\u003c/h3\u003e\r\n            \u003cp\u003eStavan Doshi, \u003cspan\u003eB.Com - Owner at The Golden Time\r\n                    JG University\u003c/span\u003e\u003c/p\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n            \u003c/div\u003e\r\n        \u003c/div\u003e\r\n    \u003c/div\u003e\r\n\u003c/section\u003e\r\n\r\n                                                                    \u003c/div\u003e\r\n                                                    \u003c/div\u003e\r\n                                    \u003c/div\u003e\r\n            \u003c/div\u003e\r\n\r\n                    \u003c/section\u003e\r\n            \r\n        \u003csection class=\"pb-themesection \"  \u003e\r\n            \r\n            \r\n            \r\n            \u003cdiv class=\"container-fluid\"\u003e\r\n                \u003cdiv class=\"row droppable-container\" data-id=\"39a28d969b\"\u003e\r\n                                            \u003cdiv class=\"col-12 p-0\"\u003e\r\n                                                            \r\n                                \u003cdiv class=\"\" \u003e\r\n                                                                            \u003cstyle\u003e\n/* ── Gallery Section ─────────────────────────────────── */\n.jg-gallery-section {\n    padding: 50px 0 60px;\n    background: #fdf8f2;\n}\n.jg-gallery-section .jg-gs-title {\n    text-align: center;\n    margin-bottom: 30px;\n}\n.jg-gallery-section .jg-gs-title h2 {\n    font-size: 2rem;\n    font-weight: 700;\n    color: #222;\n    margin-bottom: 10px;\n}\n.jg-gallery-section .jg-gs-title p {\n    font-size: 1rem;\n    color: #555;\n    margin: 0;\n}\n\n/* Tab nav */\n.jg-gs-tabs {\n    display: flex;\n    flex-wrap: nowrap;\n    overflow-x: auto;\n    justify-content: center;\n    gap: 6px;\n    margin-bottom: 28px;\n    padding-bottom: 4px;\n    -webkit-overflow-scrolling: touch;\n    scrollbar-width: none;\n}\n.jg-gs-tabs::-webkit-scrollbar { display: none; }\n.jg-gs-tabs .jg-tab-btn {\n    flex: 0 0 auto;\n    background: transparent;\n    border: none;\n    font-size: 0.95rem;\n    font-weight: 500;\n    color: #444;\n    padding: 8px 18px;\n    cursor: pointer;\n    border-bottom: 3px solid transparent;\n    transition: color 0.2s, border-color 0.2s;\n    white-space: nowrap;\n}\n.jg-gs-tabs .jg-tab-btn:hover {\n    color: #97101E;\n}\n.jg-gs-tabs .jg-tab-btn.active {\n    color: #97101E;\n    border-bottom-color: #97101E;\n    font-weight: 700;\n}\n\n/* Tab panes */\n.jg-gs-tab-content .jg-tab-pane { display: none; }\n.jg-gs-tab-content .jg-tab-pane.active { display: block; }\n\n/* Image grid – desktop bento layout */\n.jg-gs-grid {\n    display: grid;\n    grid-template-columns: repeat(5, 1fr);\n    grid-auto-rows: 230px;\n    gap: 14px;\n}\n.jg-gs-grid .jg-gs-img-wrap {\n    border-radius: 14px;\n    overflow: hidden;\n    width: 100%;\n    height: 100%;\n    background: #e0e0e0;\n}\n.jg-gs-grid .jg-gs-img-wrap img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    transition: transform 0.38s ease;\n}\n.jg-gs-grid .jg-gs-img-wrap:hover img {\n    transform: scale(1.05);\n}\n/* Bento pattern: items 1 (8n+1) and 8 (8n) span 2 columns */\n/* Row 1: wide(2) + sq + sq + sq  →  2+1+1+1 = 5 cols */\n/* Row 2: sq + sq + sq + wide(2)  →  1+1+1+2 = 5 cols */\n.jg-gs-grid .jg-gs-img-wrap:nth-child(8n+1) {\n    grid-column: span 2;\n}\n.jg-gs-grid .jg-gs-img-wrap:nth-child(8n) {\n    grid-column: span 2;\n}\n\n/* Mobile slider (hidden on desktop) */\n.jg-gs-swiper-wrap { display: none; }\n\n/* ── Responsive ───────────────────────────────────────── */\n@media (max-width: 991px) {\n    .jg-gs-grid {\n        grid-template-columns: repeat(3, 1fr);\n        grid-auto-rows: 200px;\n    }\n    /* Reset bento spanning on tablet */\n    .jg-gs-grid .jg-gs-img-wrap:nth-child(8n+1),\n    .jg-gs-grid .jg-gs-img-wrap:nth-child(8n) {\n        grid-column: span 1;\n    }\n}\n@media (max-width: 767px) {\n    .jg-gallery-section .jg-gs-title h2 { font-size: 1.5rem; }\n    .jg-gs-tabs { justify-content: flex-start; }\n\n    /* Hide grid, show swiper on mobile */\n    .jg-gs-grid { display: none !important; }\n    .jg-gs-swiper-wrap { display: block; }\n\n    .jg-gs-swiper-wrap .swiper {\n        width: 100%;\n        padding-bottom: 30px;\n    }\n    .jg-gs-swiper-wrap .swiper-slide .jg-gs-img-wrap {\n        border-radius: 10px;\n        overflow: hidden;\n        height: 220px;\n        background: #e0e0e0;\n    }\n    .jg-gs-swiper-wrap .swiper-slide .jg-gs-img-wrap img {\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n        display: block;\n    }\n    .jg-gs-swiper-wrap .swiper-pagination-bullet-active {\n        background: #97101E;\n    }\n}\n\u003c/style\u003e\n\n\u003csection class=\"jg-gallery-section\"\u003e\n    \u003cdiv class=\"container\"\u003e\n\n        \n                \u003cdiv class=\"jg-gs-title\"\u003e\n                            \u003ch2\u003eBecause life happens beyond classrooms too\u003c/h2\u003e\n                                        \u003cp\u003eSports, festivals, concerts, food courts, and friendships.\u003c/p\u003e\n                    \u003c/div\u003e\n        \n        \n            \n            \u003cdiv class=\"jg-gs-tabs\" role=\"tablist\" id=\"gs-0fde80bf-nav\"\u003e\n                                                        \u003cbutton\n                        class=\"jg-tab-btn active\"\n                        data-target=\"gs-0fde80bf-pane-0\"\n                        role=\"tab\"\n                        type=\"button\"\n                    \u003e\n                        Campus Vibes\n                    \u003c/button\u003e\n                                                                            \u003cbutton\n                        class=\"jg-tab-btn \"\n                        data-target=\"gs-0fde80bf-pane-1\"\n                        role=\"tab\"\n                        type=\"button\"\n                    \u003e\n                        Convocation\n                    \u003c/button\u003e\n                                                                            \u003cbutton\n                        class=\"jg-tab-btn \"\n                        data-target=\"gs-0fde80bf-pane-2\"\n                        role=\"tab\"\n                        type=\"button\"\n                    \u003e\n                        Sporting Events\n                    \u003c/button\u003e\n                                                                            \u003cbutton\n                        class=\"jg-tab-btn \"\n                        data-target=\"gs-0fde80bf-pane-3\"\n                        role=\"tab\"\n                        type=\"button\"\n                    \u003e\n                        Events\n                    \u003c/button\u003e\n                                                                            \u003cbutton\n                        class=\"jg-tab-btn \"\n                        data-target=\"gs-0fde80bf-pane-4\"\n                        role=\"tab\"\n                        type=\"button\"\n                    \u003e\n                        Club Council Activities\n                    \u003c/button\u003e\n                                                                            \u003cbutton\n                        class=\"jg-tab-btn \"\n                        data-target=\"gs-0fde80bf-pane-5\"\n             