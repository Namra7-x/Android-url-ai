t;\r\n            }\r\n\r\n            /* Desktop (≥992px): show main nav, hide mobile bar */\r\n            @media (min-width: 992px) {\r\n                .heading_mobile {\r\n                    display: none !important;\r\n                }\r\n                .heading_main {\r\n                    display: block !important;\r\n                }\r\n            }\r\n\r\n            /* Mobile (≤991px): show mobile bar, hide desktop nav */\r\n            @media (max-width: 991px) {\r\n                .heading_mobile {\r\n                    display: flex !important;\r\n                    align-items: center;\r\n                    justify-content: space-between;\r\n                    padding: 10px 15px;\r\n                    background: #fff;\r\n                    position: sticky;\r\n                    top: 0;\r\n                    z-index: 1000;\r\n                    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);\r\n                }\r\n                .heading_main {\r\n                    display: none !important;\r\n                }\r\n                .heading_mobile .heading_logo img {\r\n                    max-height: 50px;\r\n                    width: auto;\r\n                }\r\n                .heading_mobile_thum {\r\n                    font-size: 22px;\r\n                    cursor: pointer;\r\n                    padding: 4px 8px;\r\n                }\r\n            }\r\n\r\n            /* Ensure header stays above all page content */\r\n            header.heading {\r\n                z-index: 999 !important;\r\n            }\r\n            .heading_main.fixed-nav {\r\n                z-index: 999 !important;\r\n            }\r\n\r\n            /* Nav dropdown: hidden by default, shown on hover/click */\r\n            @media (min-width: 768px) {\r\n                li.heading_main_menu_list {\r\n                    position: relative !important;\r\n                    display: inline-block;\r\n                }\r\n                li.heading_main_menu_list ul.heading_main_menu_list_dropdown {\r\n                    opacity: 0 !important;\r\n                    visibility: hidden !important;\r\n                    pointer-events: none !important;\r\n                    position: absolute !important;\r\n                    top: 120% !important;\r\n                    left: 0 !important;\r\n                    z-index: 999 !important;\r\n                    display: block !important;\r\n                }\r\n                li.heading_main_menu_list:hover \u003e ul.heading_main_menu_list_dropdown {\r\n                    opacity: 1 !important;\r\n                    visibility: visible !important;\r\n                    pointer-events: auto !important;\r\n                    top: 100% !important;\r\n                }\r\n                li.heading_main_menu_list.clicked-open \u003e ul.heading_main_menu_list_dropdown {\r\n                    opacity: 1 !important;\r\n                    visibility: visible !important;\r\n                    pointer-events: auto !important;\r\n                    top: 100% !important;\r\n                }\r\n                .mega-menu-dropdown {\r\n                    opacity: 0 !important;\r\n                    visibility: hidden !important;\r\n                    pointer-events: none !important;\r\n                }\r\n                li.heading_main_menu_list.mega-menu-parent:hover .mega-menu-dropdown,\r\n                li.heading_main_menu_list.mega-menu-parent.clicked-open .mega-menu-dropdown {\r\n                    opacity: 1 !important;\r\n                    visibility: visible !important;\r\n                    pointer-events: auto !important;\r\n                }\r\n            }\r\n\r\n            /* Desktop nav items displayed in a horizontal row */\r\n            @media (min-width: 992px) {\r\n                nav.heading_main_menu \u003e ul {\r\n                    display: flex !important;\r\n                    flex-wrap: nowrap !important;\r\n                    a